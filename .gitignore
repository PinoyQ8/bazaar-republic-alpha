# =========================================================================================
# @file .gitignore
# @package Bazaar Republic Layer-2 DePIN Infrastructure
# @summary Standardized, production-ready Git Ignore rules for the reorganized 
#          Bazaar Republic Alpha repository (Next.js + Prisma + Docker + Rust).
# =========================================================================================

# ---> Dependency Directories
node_modules/
jspm_packages/
web_modules/

# ---> Next.js Build & Compilation Outputs
.next/
out/
build/
dist/

# ---> Prisma Generated Clients & Assets
# Ignore custom generated database client folder to keep Git size small
# Note: These are automatically re-compiled on npm install / prisma generate
app/lib/generated/
generated/client/
bzr-db/

# ---> Environment Variables & Workstation Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
config_options.yml
config_options.local.yml

# ---> Docker & Database Logs/Caches
.docker/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
docker-compose.override.yml

# Local directory mapping for MongoDB volume storage (prevent syncing massive database files)
mongodb_data/
bazaar_ledger_data/

# ---> Rust (Soroban Smart Contracts) Compilation Outputs
# Cargo output directory inside contracts or root
contracts/target/
target/
**/*.rs.bk

# ---> Python Bytecode & Simulation Caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# ---> Workstation & IDE Configuration Logs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# ---> OS Specific (Windows / macOS) Caches
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
.DS_Store

# ---> Script Workspace Output & Diagnostics
# Keep main diagnostic scripts, ignore local verification session results
bazaar_e2e_test_execution.log
node_modules

# Local Prisma generated client types
prisma/generated/

# Vercel deployment metadata
.vercel/

# TypeScript build metadata cache
tsconfig.tsbuildinfo