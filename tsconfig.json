{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "bzr-db": [
        "./node_modules/bzr-db" // 🟢 Points VS Code to the node_modules cache
      ],
      "bzr-db/*": [
        "./node_modules/bzr-db/*"
      ],
      "@/contracts/*": [
        "./src/contracts/*",
        "./contracts/*"
      ],
      "@/context/*": [
        "./src/context/*",
        "./context/*",
        "./app/context/*"
      ],
      "@/hooks/*": [
        "./src/hooks/*",
        "./hooks/*",
        "./app/hooks/*"
      ],
      "@/lib/*": [
        "./src/lib/*",
        "./lib/*",
        "./app/lib/*"
      ],
      "@/components/*": [
        "./src/components/*",
        "./components/*",
        "./app/components/*"
      ],
      "@/actions/*": [
        "./src/actions/*",
        "./app/actions/*",
        "./actions/*"
      ],
      "@/*": [
        "./*",
        "./src/*",
        "./app/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "fix-build-config.mjs",
    "*.mjs"
  ]
}
