{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/context/*": ["./app/context/*", "./src/context/*", "./context/*"],
      "@/actions/*": ["./app/actions/*", "./src/actions/*", "./actions/*"],
      "@/components/*": ["./components/*", "./src/components/*", "./app/components/*"],
      "@/hooks/*": ["./hooks/*", "./src/hooks/*", "./app/hooks/*"],
      "@/lib/*": ["./lib/*", "./src/lib/*", "./app/lib/*"],
      "@/contracts/*": ["./src/contracts/*", "./contracts/*"],
      "@/*": ["./*", "./src/*", "./app/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts",
    "models",
    "bazaar_*.tsx",
    "bazaar_*.ts"
  ]
}