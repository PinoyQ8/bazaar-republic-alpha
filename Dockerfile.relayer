# =========================================================================
# STAGE 1: Build & Generate Client (Upgraded to Node 22 LTS & Hardened)
# =========================================================================
FROM node:22-alpine AS builder
WORKDIR /app
ENV HUSKY=0
ENV NODE_ENV=production

# Copy package definitions and prisma schema first for aggressive caching
COPY package*.json ./
COPY prisma ./prisma/

# 🟢 UPDATE THIS LINE (Line 14) to include --ignore-scripts
RUN npm install --ignore-scripts

# Manually trigger the native Alpine musl Prisma engine generation
RUN npx prisma generate

# Copy the remaining project files
COPY . .

# =========================================================================
# STAGE 2: Lightweight Production Runner
# =========================================================================
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# Copy the entire generated workspace from the builder
COPY --from=builder /app ./

# Boot the isolated relayer daemon using tsx
CMD ["npx", "tsx", "bazaar_relayer.ts"]