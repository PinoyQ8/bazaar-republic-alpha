generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Tier {
  GENESIS
  CITIZEN
  PIONEER
  NOVICE
  ACADEMY_CORE
  MESH_GUARDIAN
  BAZAAR_FOUNDER
  STANDARD
}

enum NodeStatus {
  SYNCING
  ACTIVE
  FROZEN
  SUSPENDED
  QUARANTINED
  MAINTENANCE
}

enum ProposalStatus {
  ACTIVE
  PASSED
  REJECTED
  EXPIRED
}

enum VoteDecision {
  YES
  NO
  ABSTAIN
}

enum PaymentStatus {
  INITIALIZED
  PENDING
  APPROVED
  COMPLETED
  CANCELLED
  FAILED
}

enum LedgerTxType {
  GENESIS_MINT
  EARLY_REDEEM
  SERVICE_SETTLEMENT
  SLASH_PENALTY
  SLASH_REWARD
  SLASH_SETTLEMENT
  TRANSFER
  SHIELD_ARM
  SHIELD_SWEEP
  MASTER_REVOKE
}

// =============================================================
// RFC-002: L1 Anti-Sweeper Shield & Recovery Protocol
// =============================================================

enum TargetStatus {
  UNARMED
  ARMED_2OF2
  NEUTRALIZED_REVOKED
}

enum ShieldEventType {
  AUDIT
  ARM_SHIELD
  SWEEP_PAYMENT
  SWEEP_CREATE_ACCOUNT
  REVOKE_MASTER
  SSE_AUTO_SWEEP
}

model ShieldAccount {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  targetAddress   String       @unique // 56-char Stellar/Pi public key (G...)
  guardianAddress String       // Guardian public key (G...)
  recoveryVault   String       // Cold vault destination (G...)
  status          TargetStatus @default(UNARMED)

  initialBalance Float @default(0.0)
  currentBalance Float @default(0.0)
  reservedBuffer Float @default(1.60)
  masterWeight   Int   @default(1)

  lowThreshold  Int @default(0)
  medThreshold  Int @default(0)
  highThreshold Int @default(0)

  // Direct reference to PioneerNode
  pioneerUid  String?      @unique
  pioneerNode PioneerNode? @relation(fields: [pioneerUid], references: [uid])

  recoveries RecoverySettlement[]
  events     ShieldEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guardianAddress])
  @@index([status])
}

model RecoverySettlement {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  shieldAccountId String   @db.ObjectId
  evacuatedAmount Float
  vaultAddress    String
  operationType   String   @default("PAYMENT") // PAYMENT | CREATE_ACCOUNT
  armTxHash       String?
  sweepTxHash     String
  revokeTxHash    String?
  settledLedger   Int?
  settledAt       DateTime @default(now())

  shieldAccount ShieldAccount @relation(fields: [shieldAccountId], references: [id])

  @@index([shieldAccountId])
  @@index([sweepTxHash])
}

model ShieldEvent {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  shieldAccountId String          @db.ObjectId
  eventType       ShieldEventType
  txHash          String?
  details         String? // Serialized JSON string
  createdAt       DateTime        @default(now())

  shieldAccount ShieldAccount @relation(fields: [shieldAccountId], references: [id])

  @@index([shieldAccountId, eventType])
}

model PioneerNode {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  uid           String     @unique
  username      String?    @unique
  walletAddress String?    @unique
  tier          Tier       @default(CITIZEN)
  status        NodeStatus @default(SYNCING)
  isFrozen      Boolean    @default(false)
  freezeReason  String?
  trustScore    Float      @default(100.0)

  regionCode    String? @default("US")
  countryCode   String? @default("US")
  phonePrefix   String? @default("+1")
  pppMultiplier Float   @default(1.0)

  balance              String? @default("0")
  mbzrBalance          Float   @default(0)
  mbzrBalanceSubunits  String? @default("0")
  mbzrBalanceFormatted String? @default("0.0000000")

  cpuUsage            String? @default("25.0%")
  ramUsage            String? @default("4.0GB")
  ssdLatency          String? @default("100 MB/s")
  downtimeHours       Float   @default(0)
  accumulatedDowntime Float   @default(0)
  uptimeShield        Float   @default(100.0)

  stakedPi            Float   @default(0)
  mintedPiTotal       Float   @default(0)
  signature           String?
  ledgerHeight        Int     @default(0)
  syncState           String  @default("Unknown")
  activePeers         Int     @default(0)
  protocol            String  @default("28")
  
  // RFC-002 Quarantine & Rescue Fields
  isUnderRemoteRescue Boolean   @default(false)
  quarantineStatus    String    @default("NONE") // NONE | QUARANTINED | REVOKED
  quarantineReason    String?
  quarantineDate      DateTime?
  vaultAddress        String?   // Rerouted cold vault for payouts/yields
  migrationHash       String?
  dormancyPiBalance   Float     @default(0)
  dormancyMBzrBalance Float     @default(0)

  // Reverse relation to ShieldAccount
  shieldAccount ShieldAccount?

  lastEpochYield    Float     @default(0)
  nextEpochEligible DateTime?
  stakeWeight       Float     @default(0)

  // Contributor Security Graph & Governance Fields
  completedAlphaSessions Int                  @default(0)
  isContributorUnlocked  Boolean              @default(false)
  isElderEligible        Boolean              @default(false)
  securityCircleOutbound SecurityCircleEdge[] @relation("TrusterRelation")
  securityCircleInbound  SecurityCircleEdge[] @relation("TrustedRelation")

  lastActivityTimestamp DateTime @default(now())
  lastHeartbeat         DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  paymentsMade Payment[]           @relation("PaymentsMade")
  passkeys     PasskeyCredential[]

  @@index([status, trustScore])
  @@index([quarantineStatus])
  @@index([isElderEligible, isContributorUnlocked])
}

model SecurityCircleEdge {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  trusterUid    String
  trustedUid    String
  vouchHumanity Boolean  @default(true) // Asserts peer is a verified human
  vouchEthical  Boolean  @default(true) // Asserts peer is ethical/non-fraudulent
  createdAt     DateTime @default(now())

  truster PioneerNode @relation("TrusterRelation", fields: [trusterUid], references: [uid], onDelete: Cascade)
  trusted PioneerNode @relation("TrustedRelation", fields: [trustedUid], references: [uid], onDelete: Cascade)

  @@unique([trusterUid, trustedUid])
  @@index([trusterUid])
  @@index([trustedUid])
}

model PasskeyCredential {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  credentialId String   @unique
  pioneerUid   String
  publicKey    String
  counter      Int      @default(0)
  transports   String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pioneer PioneerNode @relation(fields: [pioneerUid], references: [uid])

  @@index([pioneerUid])
}

model ServiceProvider {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  businessName     String
  category         String
  description      String
  providerUid      String
  sectorLocation   String
  mbzrRate         Float
  unitLabel        String
  isVerified       Boolean  @default(false)
  totalSettlements Int      @default(0)
  rating           Float    @default(5.0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  escrowLocks EscrowLock[]

  @@index([category, isVerified])
}

model EscrowLock {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  escrowId           String   @unique
  paymentId          String?  @unique
  txid               String?  @unique
  consumerUid        String
  providerId         String   @db.ObjectId
  amount             Float
  token              String   @default("PI")
  status             String   @default("LOCKED") // "LOCKED" | "RELEASED" | "DISPUTED" | "REFUNDED"
  timelockExpiresAt  DateTime
  serviceDescription String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  provider ServiceProvider @relation(fields: [providerId], references: [id])
  dispute  DisputeRecord?

  @@index([consumerUid])
  @@index([status])
}

model DisputeRecord {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  escrowLockId     String   @unique @db.ObjectId
  initiatorUid     String
  bondAmount       Float    // Collateral mBZR bond (5-10% of lock)
  selectedElders   String[] // 5 randomly selected Genesis 100 Elders
  votesForConsumer Int      @default(0)
  votesForMerchant Int      @default(0)
  status           String   @default("VOTING") // "VOTING" | "RESOLVED_CONSUMER" | "RESOLVED_MERCHANT" | "SLASHED"
  reason           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  escrowLock EscrowLock   @relation(fields: [escrowLockId], references: [id], onDelete: Cascade)
  votes      VoteRecord[]

  @@index([initiatorUid])
  @@index([status])
  @@map("dispute_records")
}

model VoteRecord {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  disputeId String        @db.ObjectId
  voterUid  String
  decision  String        // "REFUND_CONSUMER" | "RELEASE_MERCHANT"
  createdAt DateTime      @default(now())
  dispute   DisputeRecord @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
  @@map("dispute_vote_records")
}

model MeshLedger {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  walletId       String?
  txSignature    String?      @unique
  txHash         String?
  txType         LedgerTxType @default(SERVICE_SETTLEMENT)
  fromUid        String?
  toUid          String?
  piAmount       Float        @default(0)
  mbzrAmount     Float        @default(0)
  amount         Float        @default(0)
  penaltyApplied Float        @default(0)
  meltBurnAmount Float        @default(0)
  yieldAmount    Float        @default(0)
  status         String       @default("CONFIRMED")
  description    String?
  timestamp      DateTime?    @default(now())
  createdAt      DateTime?    @default(now())

  @@index([walletId])
  @@index([txType])
}

model InternalProposal {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String
  status       ProposalStatus @default(ACTIVE)
  authorUid    String?
  votesFor     Int            @default(0)
  votesAgainst Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  expiresAt    DateTime?

  votes VoteRecordModel[]
}

model VoteRecordModel {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  decision   VoteDecision
  proposalId String           @db.ObjectId
  voterId    String
  voterUid   String?
  createdAt  DateTime         @default(now())
  proposal   InternalProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@map("vote_records")
}

model Payment {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  paymentId   String        @unique
  txid        String        @unique
  payerUid    String
  merchantUid String
  amount      Float
  status      PaymentStatus @default(COMPLETED)
  createdAt   DateTime      @default(now())

  payer PioneerNode @relation("PaymentsMade", fields: [payerUid], references: [uid])
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  action    String
  payload   String
  nodeId    String
  timestamp DateTime @default(now())
}

model RelayerSyncState {
  id                    String   @id @map("_id")
  network               String   @unique @default("pi-testnet")
  lastLedger            Int      @default(0)
  lastSweepTx           String?
  totalPiEvacuated      Float    @default(0.0)
  activeShields         Int      @default(0)
  updatedAt             DateTime @updatedAt
  syncedAt              DateTime @default(now())
}

model AcademyLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  pioneerUid String
  moduleKey  String
  status     String   @default("COMPLETED")
  createdAt  DateTime @default(now())

  @@unique([pioneerUid, moduleKey])
}

model MbzrTransaction {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  senderAddress   String
  receiverAddress String
  amountSubunits  String
  amountFormatted String
  txType          String   @default("TRANSFER")
  stellarTxHash   String?
  status          String   @default("SUCCESS")
  createdAt       DateTime @default(now())
}

model BridgeReceipt {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userAddress   String
  nonce         Int
  mBzrAmount    String
  piAmount      Float
  stellarTxHash String?
  status        String    @default("SUCCESS")
  piTxId        String?
  errorLog      String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
}
