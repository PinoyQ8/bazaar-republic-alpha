datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 🌌 CORE IDENTITY & STATUS PERIMETER
// ==========================================

model Pioneer {
  id         Int      @id @default(autoincrement())
  pioneerUid String   @unique
  role       String   @default("PIONEER")
  trustScore Float    @default(1.0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("pioneers")
}

// (Ensure your other tables: InternalProposal, InternalVote, AcademyLog continue cleanly below this point)

model CitizenPassport {
  id         Int      @id @default(autoincrement())
  pioneerUid String   @unique
  status     String   @default("ACTIVE")
  tier       Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("citizen_passports")
}

// 🛡️ RECOVERED BLOCK: STASIS PROTOCOL TRACKING LEDGER
model RecoveryLedger {
  id         Int      @id @default(autoincrement())
  citizenUid String   @unique
  status     String   @default("STASIS")
  nodeIp     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("recovery_ledgers")
}

// ==========================================
// 🔐 LAYER 01: INTERNAL DAO GOVERNANCE (STAKED CORE)
// ==========================================

model InternalProposal {
  id             Int            @id @default(autoincrement())
  title          String
  description    String
  requiredWeight Float          @default(1.0)
  status         String         @default("BUFFER") // BUFFER | ACTIVE | LOCKED
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  votes          InternalVote[]

  @@map("internal_proposals")
}

model InternalVote {
  id         Int              @id @default(autoincrement())
  pioneerUid String           // Flat token index anchor to pioneers table
  weight     Float            @default(1.0)
  decision   String           // FOR | AGAINST
  proposalId Int
  proposal   InternalProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())

  @@unique([pioneerUid, proposalId]) // Enforces 1 absolute vote per proposal ledger
  @@index([pioneerUid])              // Optimized indexing for high-velocity account scans
  @@map("internal_votes")
}

// ==========================================
// 📡 LAYER 02: PUBLIC PI COMMUNITY GOVERNANCE (ECOSYSTEM PORTAL)
// ==========================================

model CommunityPoll {
  id        Int             @id @default(autoincrement())
  title     String
  summary   String
  piTxHash  String?         // Track validation transaction hash flags if gas/fees are used
  status    String          @default("ACTIVE") // ACTIVE | CONCLUDED
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  votes     CommunityVote[]

  @@map("community_polls")
}

model CommunityVote {
  id         Int           @id @default(autoincrement())
  piUsername String        // Captured natively straight from Pi SDK payload strings
  decision   String        // FOR | AGAINST
  pollId     Int
  poll       CommunityPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@unique([piUsername, pollId]) // Firewalled to block public double-voting exploits
  @@index([piUsername])          // Optimized indexing for external profile lookups
  @@map("community_votes")
}

// ==========================================
// 🎓 MESH ACADEMY: PIONEER PROGRESS LEDGER
// ==========================================

model AcademyLog {
  id           Int      @id @default(autoincrement())
  pioneerUid   String   // The Pi Network UID of the user
  moduleLocked String   // The specific sector, e.g., "module-03-zero-trust"
  status       String   @default("COMPLETED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([pioneerUid, moduleLocked]) // Prevents double-stamping the same module
  @@index([pioneerUid])                // Speeds up Pioneer dashboard load times
  @@map("academy_logs")
}

// ==========================================
// 🪙 LAYER 03: E-NETWORK ECONOMIC LEDGER
// ==========================================

model Payment {
  id         Int      @id @default(autoincrement())
  paymentId  String   @unique // The unique payment String hash returned by the Pi SDK
  pioneerUid String   // Anchored directly to your Core Identity Perimeter
  amount     Float    @default(0.01)
  status     String   // PENDING | COMPLETED | FAILED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("pi_payments")
}

model UserWallet {
  id          Int      @id @default(autoincrement())
  pioneerUid  String   @unique // One unique wallet per verified Pioneer Node
  mbzrBalance Float    @default(0.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("user_wallets")
}