// 🛡️ BAZAAR VAULT CONFIG (PRISMA 7 COMPLIANT)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// 🛡️ RECOVERY STATES
enum RecoveryStatus {
  STASIS     // 24-hour countdown in progress
  EXPIRED    // Stasis over, claimable by heir
  ABORTED    // Original Pioneer cancelled the request
  FINALIZED  // Ownership has been transferred
}

// 🛡️ THE RECOVERY LEDGER
model RecoveryLedger {
  id            String         @id @default(cuid())
  citizenUid    String         // Removed @unique to allow historical logging
  initiatorHeir String         // The address of the heir who triggered it
  
  stasisStart   DateTime       @default(now())
  stasisEnd     DateTime       // Calculated at injection (now + 24hrs)
  
  status        RecoveryStatus @default(STASIS)
  
  ipAddress     String?
  userAgent     String?
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // MESH: Compound index ensures fast querying for active stasis checks
  @@index([citizenUid, status])
}