// // ⚡ prisma/schema.prisma
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/client"
}

// Your Pioneer and CitizenPassport models follow here untouched...
model Pioneer {
  id          Int      @id @default(autoincrement())
  pioneerUid  String   @unique
  role        String   @default("PIONEER")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pioneers")
}

model CitizenPassport {
  id          Int      @id @default(autoincrement())
  pioneerUid  String   @unique
  status      String   @default("ACTIVE")
  tier        Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("citizen_passports")
}

// 🛡️ RECOVERED BLOCK: STASIS PROTOCOL TRACKING LEDGER
model RecoveryLedger {
  id          Int      @id @default(autoincrement())
  citizenUid  String   @unique
  status      String   @default("STASIS")
  nodeIp      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("recovery_ledgers")
}