// 🛡️ NEO PROTOCOL SCHEMA
generator client {
  provider   = "prisma-client-js"
  engineType = "library" // 🛡️ STRICT NODE.JS BINARY LOCK
}

datasource db {
  provider = "mongodb"
}

// ... your PioneerNode model below

// Ensure your models follow below
model PioneerNode {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  username     String @unique
  walletAddress String @unique
  role         String
  status       String
}