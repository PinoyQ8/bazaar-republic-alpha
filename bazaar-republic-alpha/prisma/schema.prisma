// 🛡️ NEO PROTOCOL: SCHEMA VERSION 2.3 (Unified & Hardened)
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
  // 🛡️ MESH ANCHOR: No custom output. Strictly bound to @prisma/client
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

// ----------------------------------------------------------------------
// 🛡️ ENUMERATIONS: Enforcing Data Consistency
// ----------------------------------------------------------------------
enum Tier {
  CITIZEN
  NOVICE
  ACADEMY_CORE
  MESH_GUARDIAN
  BAZAAR_FOUNDER
}

enum NodeStatus {
  SYNCING
  ACTIVE
  FROZEN
  SUSPENDED
}

enum ProposalStatus {
  ACTIVE
  PASSED
  REJECTED
  EXPIRED
}

enum VoteDecision {
  YES
  NO
  ABSTAIN
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum LedgerTxType {
  GENESIS_MINT
  EARLY_REDEEM
}

// ----------------------------------------------------------------------
// 🛡️ MESH LEDGER: Identity & State
// ----------------------------------------------------------------------
model PioneerNode {
  id                    String     @id @default(auto()) @map("_id") @db.ObjectId
  uid                   String     @unique
  username              String?    @unique
  walletAddress         String?    @unique
  tier                  Tier       @default(CITIZEN)
  status                NodeStatus @default(SYNCING)
  isFrozen              Boolean    @default(false)
  freezeReason          String?
  trustScore            Int        @default(0)
  stakedPi              Float      @default(0)
  mbzrBalance           Float      @default(0) // 🛡️ MESH PATCH: Synthetic Gold State
  signature             String?
  ledgerHeight          Int        @default(0)
  syncState             String     @default("Unknown")
  activePeers           Int        @default(0)
  protocol              String     @default("24")
  isUnderRemoteRescue   Boolean    @default(false)
  lastActivityTimestamp DateTime   @default(now())
  lastHeartbeat         DateTime   @default(now())
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  // RELATIONS
  paymentsMade Payment[] @relation("PaymentsMade")
}

// ----------------------------------------------------------------------
// 🛡️ COMMERCE ENGINE: Settlement Records
// ----------------------------------------------------------------------
model Payment {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  paymentId   String        @unique
  txid        String        @unique
  payerUid    String
  merchantUid String
  amount      Float
  status      PaymentStatus @default(COMPLETED)
  createdAt   DateTime      @default(now())

  // RELATION ANCHOR
  payer       PioneerNode   @relation("PaymentsMade", fields: [payerUid], references: [uid])
}

// ----------------------------------------------------------------------
// 🛡️ ECONOMIC ENGINE: Synthetic Asset Ledger (v2.3)
// ----------------------------------------------------------------------
model MeshLedger {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  walletId        String       // Maps to PioneerNode.uid
  txSignature     String?      @unique // L1 Pi TxHash (Null for redemptions)
  txType          LedgerTxType
  piAmount        Float        @default(0) // Pi locked or unlocked
  mbzrAmount      Float        @default(0) // mBZR minted or redeemed
  penaltyApplied  Float        @default(0) // % penalty for early redeem
  meltBurnAmount  Float        @default(0) // mBZR sent to burn address
  yieldAmount     Float        @default(0) // mBZR redistributed to stakers
  timestamp       DateTime     @default(now())
}

// ----------------------------------------------------------------------
// 🛡️ GOVERNANCE ENGINE: DAO Consensus (v2.3)
// ----------------------------------------------------------------------
model InternalProposal {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String
  status       ProposalStatus @default(ACTIVE)
  authorUid    String?        // 🛡️ MESH PATCH: Restored
  votesFor     Int            @default(0) // 🛡️ MESH PATCH: Restored
  votesAgainst Int            @default(0) // 🛡️ MESH PATCH: Restored
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt  // 🛡️ MESH PATCH: Restored
  expiresAt    DateTime?      // 🛡️ MESH PATCH: Restored
  
  votes        VoteRecord[]
}

model VoteRecord {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  decision   VoteDecision
  proposalId String           @db.ObjectId
  voterId    String           // 🛡️ MESH PATCH: Aligned to TS expectation
  voterUid   String?          
  createdAt  DateTime         @default(now())
  
  proposal   InternalProposal @relation(fields: [proposalId], references: [id])
}

// ----------------------------------------------------------------------
// 🛡️ SECURITY & ACADEMY MODULES (v2.3)
// ----------------------------------------------------------------------
model SecurityCircle {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  ownerUid       String   @unique
  pioneerId      String?  @unique // 🛡️ MESH PATCH: Restored
  linkedUsername String?          // 🛡️ MESH PATCH: Restored
  nodes          String[] 
  createdAt      DateTime @default(now())
}

model AcademyLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  pioneerUid   String
  action       String
  moduleLocked String?  // 🛡️ MESH PATCH: Restored
  createdAt    DateTime @default(now())
}