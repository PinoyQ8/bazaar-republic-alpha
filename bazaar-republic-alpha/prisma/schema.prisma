// 🛡️ NEO PROTOCOL: SCHEMA VERSION 2.0 (Governance Hardened)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI") // 🛡️ BAZAAR TECH BYPASS: MONGODB_URI ANCHOR
}

// 🛡️ MESH HIERARCHY: Strict Access Control
enum Tier {
  CITIZEN
  NOVICE
  ACADEMY_CORE
  MESH_GUARDIAN
  BAZAAR_FOUNDER
}

// 🛡️ GOVERNANCE STATUS: Enforced Consistency
enum NodeStatus {
  SYNCING
  ACTIVE
  FROZEN
  SUSPENDED
}

// 🛡️ MESH LEDGER: PioneerNode Model
model PioneerNode {
  id                    String     @id @default(auto()) @map("_id") @db.ObjectId
  uid                   String     @unique
  username              String?    @unique
  walletAddress         String?    @unique
  
  tier                  Tier       @default(CITIZEN) 
  status                NodeStatus @default(SYNCING)
  
  // 🛡️ GOVERNANCE LOCKS
  isFrozen              Boolean    @default(false)
  freezeReason          String?
  
  // 🛡️ IDENTITY & PERFORMANCE
  trustScore            Int        @default(0)
  stakedPi              Float      @default(0)
  signature             String?    
  
  // 🛰️ HARDWARE & TELEMETRY
  ledgerHeight          Int        @default(0)
  syncState             String     @default("Unknown")
  activePeers           Int        @default(0)
  protocol              String     @default("24")
  isUnderRemoteRescue   Boolean    @default(false)

  // 🛡️ TIMEKEEPING
  lastActivityTimestamp DateTime   @default(now())
  lastHeartbeat         DateTime   @default(now())
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt // 🛡️ Automatically tracks modifications
}

// 🛰️ ACADEMY LOG MODEL
model AcademyLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  pioneerUid   String   // Logical link to PioneerNode.uid
  moduleLocked String
  createdAt    DateTime @default(now())
}

// 🛡️ PAYMENTS & PROPOSALS
model Payment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  paymentId   String   @unique 
  txid        String   @unique 
  payerUid    String
  merchantUid String
  amount      Float
  status      String   @default("COMPLETED")
  createdAt   DateTime @default(now())
}

// 🛡️ GOVERNANCE MODEL UPDATE
model InternalProposal {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  description     String
  authorUid       String   
  status          String   @default("ACTIVE") 
  targetParameter String?  // 🛡️ ADDED: For DEX/System tuning
  proposedValue   Float?   // 🛡️ ADDED: For quantitative proposals
  votesFor        Int      @default(0) // 🛡️ ENSURE THESE EXIST
  votesAgainst    Int      @default(0) // 🛡️ ENSURE THESE EXIST
  expiresAt       DateTime?   // 🛡️ BAZAAR TECH: Optional modifier added
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // 🛡️ MESH RELATION: Two-way binding established
  votes           VoteRecord[] 
}

// 🛡️ GOVERNANCE RECORD MATRIX
model VoteRecord {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  proposalId  String   @db.ObjectId
  voterId     String
  decision    String   // "YES" | "NO" | "ABSTAIN"
  castAt      DateTime @default(now())

  // 🛡️ MESH RELATION: Binds the vote directly to the internal proposal cluster
  proposal    InternalProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, voterId]) // 🛡️ FRONT-RUNNING SHIELD: One vote per Pioneer per proposal
}