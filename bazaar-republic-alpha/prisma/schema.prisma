// 🛡️ NEO PROTOCOL SCHEMA
generator client {
  provider   = "prisma-client-js"
  engineType = "library" // 🛡️ STRICT NODE.JS BINARY LOCK
}

// 🛡️ NEO PROTOCOL: Hard-coded MongoDB routing
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// 🛡️ MESH HIERARCHY: Strict Access Control Engine
enum Tier {
  CITIZEN
  NOVICE
  ACADEMY_CORE
  MESH_GUARDIAN
  BAZAAR_FOUNDER
}

// 🛡️ MESH LEDGER: Expanded PioneerNode Model
model PioneerNode {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  
  // 🛡️ THE HARDWARE BINDING (Required for Telemetry targeting)
  // BAZAAR TECH FIX: Removed static default to prevent fatal duplicate key crashes on registration.
  uid                 String   @unique

  // Existing Identity Fields
  username            String?  @unique
  walletAddress       String?  @unique
  
  // 🛡️ REPLACED 'role' WITH 'tier' ENUM TO FIX THE 500 ROUTING ERROR
  tier                Tier     @default(CITIZEN) 
  
  status              String   @default("SYNCING")
  trustScore          Int      @default(0)
  stakedPi            Float    @default(0)
  lastActivityTimestamp DateTime @default(now())
  createdAt           DateTime @default(now())

  // 🛰️ HARD-CODED TELEMETRY FIELDS
  ledgerHeight        Int      @default(0)
  syncState           String   @default("Unknown")
  activePeers         Int      @default(0)
  protocol            String   @default("24")
  lastHeartbeat       DateTime @default(now())
  
  // 🛡️ ADDED FOR REMOTE ADMIN PROTOCOL
  isUnderRemoteRescue Boolean  @default(false)
}

// 🛰️ ACADEMY LOG MODEL FOR TS VALIDATION
model AcademyLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  pioneerUid   String
  moduleLocked String
  createdAt    DateTime @default(now())
}

model Payment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  paymentId   String   @unique 
  txid        String   @unique // 🛡️ On-Chain Transaction Hash
  payerUid    String
  merchantUid String
  amount      Float
  status      String   @default("COMPLETED")
  createdAt   DateTime @default(now())
}

model InternalProposal {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String
  authorUid    String   // 🛡️ The Pioneer Node who submitted the proposal
  status       String   @default("PENDING") // PENDING, ACTIVE, PASSED, REJECTED
  votesFor     Int      @default(0)
  votesAgainst Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}