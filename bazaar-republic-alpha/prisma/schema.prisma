// 🛡️ NEO PROTOCOL: SCHEMA VERSION 2.5 (Unified & Hardened)
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
  // 🛡️ MESH ANCHOR: No custom output. Strictly bound to @prisma/client
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL") // Ensure this matches your .env file
}

// ----------------------------------------------------------------------
// 🛡️ ENUMERATIONS: Enforcing Data Consistency
// ----------------------------------------------------------------------
enum Tier {
  CITIZEN
  NOVICE
  ACADEMY_CORE
  MESH_GUARDIAN
  BAZAAR_FOUNDER
}

enum NodeStatus {
  SYNCING
  ACTIVE
  FROZEN
  SUSPENDED
}

enum ProposalStatus {
  ACTIVE
  PASSED
  REJECTED
  EXPIRED
}

enum VoteDecision {
  YES
  NO
  ABSTAIN
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum LedgerTxType {
  GENESIS_MINT
  EARLY_REDEEM
  SERVICE_SETTLEMENT // 🛡️ Added to support E-Network micro-settlements
}

// ----------------------------------------------------------------------
// 🛡️ MESH LEDGER: Identity & State
// ----------------------------------------------------------------------
model PioneerNode {
  id                    String     @id @default(auto()) @map("_id") @db.ObjectId
  uid                   String     @unique
  username              String?    @unique
  walletAddress         String?    @unique
  tier                  Tier       @default(CITIZEN)
  status                NodeStatus @default(SYNCING)
  isFrozen              Boolean    @default(false)
  freezeReason          String?
  trustScore            Int        @default(0)
  stakedPi              Float      @default(0)
  mbzrBalance           Float      @default(0) // 🛡️ Synthetic Gold State
  signature             String?
  ledgerHeight          Int        @default(0)
  syncState             String     @default("Unknown")
  activePeers           Int        @default(0)
  protocol              String     @default("24")
  isUnderRemoteRescue   Boolean    @default(false)
  
  // 🛡️ SAFE HARBOR PROTOCOL (DORMANCY VAULT)
  quarantineStatus      String     @default("NONE") // States: "NONE", "QUARANTINED", "ABANDONED"
  migrationHash         String?                     // Cryptographic Bridge Key for banned nodes
  quarantineDate        DateTime?                   // Timestamp triggering the 12-Month Lock
  dormancyPiBalance     Float      @default(0)      // Isolated 1,000 Pi Collateral
  dormancyMBzrBalance   Float      @default(0)      // Isolated mBZR utility balance

  // ⚙️ 70/30 EPOCH YIELD MATRIX
  lastEpochYield        Float      @default(0)      // Native Pi received in the last 30-Day Epoch
  nextEpochEligible     DateTime?                   // Timestamp anchoring the node to the 30-Day rule
  stakeWeight           Float      @default(0)      // Cached percentage of network weight for fast querying

  lastActivityTimestamp DateTime   @default(now())
  lastHeartbeat         DateTime   @default(now())
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  // RELATIONS
  paymentsMade Payment[] @relation("PaymentsMade")
}

// ----------------------------------------------------------------------
// 🛡️ COMMERCE ENGINE: Legacy Settlement Records
// ----------------------------------------------------------------------
model Payment {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  paymentId   String        @unique
  txid        String        @unique
  payerUid    String
  merchantUid String
  amount      Float
  status      PaymentStatus @default(COMPLETED)
  createdAt   DateTime      @default(now())

  // RELATION ANCHOR
  payer       PioneerNode   @relation("PaymentsMade", fields: [payerUid], references: [uid])
}

// ----------------------------------------------------------------------
// 🛡️ ECONOMIC ENGINE: Unified Synthetic Asset Ledger (v2.4)
// ----------------------------------------------------------------------
model MeshLedger {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  walletId       String       // Maps to PioneerNode.uid
  txSignature    String?      @unique // L1 Pi TxHash (Null for redemptions & settlements)
  txType         LedgerTxType // ENUM: GENESIS_MINT, EARLY_REDEEM, SERVICE_SETTLEMENT
  piAmount       Float        @default(0) // Pi locked or unlocked
  mbzrAmount     Float        @default(0) // mBZR minted, redeemed, or settled
  penaltyApplied Float        @default(0) // % penalty for early redeem
  meltBurnAmount Float        @default(0) // mBZR sent to burn address
  yieldAmount    Float        @default(0) // mBZR redistributed to stakers
  status         String       @default("CONFIRMED") // Micro-settlement status
  createdAt      DateTime     @default(now())
}

// ----------------------------------------------------------------------
// 🛡️ GOVERNANCE ENGINE: Internal Admin DAO
// ----------------------------------------------------------------------
model InternalProposal {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String
  status       ProposalStatus @default(ACTIVE)
  authorUid    String?        
  votesFor     Int            @default(0) 
  votesAgainst Int            @default(0) 
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt  
  expiresAt    DateTime?      
  
  votes        VoteRecord[]
}

model VoteRecord {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  decision   VoteDecision
  proposalId String           @db.ObjectId
  voterId    String           
  voterUid   String?          
  createdAt  DateTime         @default(now())
  
  proposal   InternalProposal @relation(fields: [proposalId], references: [id])
}

// ----------------------------------------------------------------------
// 🛡️ PUBLIC DAO ENGINE: E-Network Proposals
// ----------------------------------------------------------------------
model DaoProposal {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String
  category     String
  proposerUid  String
  status       String
  votesFor     Float     @default(0)
  votesAgainst Float     @default(0)
  votesAbstain Float     @default(0)
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  votes        DaoVote[]
}

model DaoVote {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  proposalId  String      @db.ObjectId
  pioneerUid  String
  choice      String
  votingPower Float
  createdAt   DateTime    @default(now())
  
  proposal    DaoProposal @relation(fields: [proposalId], references: [id])
}

// ----------------------------------------------------------------------
// 🛡️ E-NETWORK MODULE: Service Provider Directory
// ----------------------------------------------------------------------
model ServiceProvider {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  businessName     String
  category         String
  description      String
  providerUid      String
  sectorLocation   String
  mbzrRate         Float
  unitLabel        String
  isVerified       Boolean  @default(false)
  totalSettlements Int      @default(0)
  rating           Float    @default(5.0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ----------------------------------------------------------------------
// 🛡️ SECURITY & ACADEMY MODULES (v2.3)
// ----------------------------------------------------------------------
model SecurityCircle {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  ownerUid       String   @unique
  pioneerId      String?  @unique
  linkedUsername String?  
  nodes          String[] 
  createdAt      DateTime @default(now())
}

model AcademyLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  pioneerUid   String
  action       String
  moduleLocked String?  
  createdAt    DateTime @default(now())
}

// ----------------------------------------------------------------------
// ⚙️ E-NETWORK SETTLEMENT BUFFER (70/30 MATRIX)
// ----------------------------------------------------------------------
model EpochBuffer {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  epochMonth        String   @unique // e.g., "2026-08"
  status            String   @default("ACCUMULATING") // "ACCUMULATING", "DISTRIBUTED"
  
  // The aggregated Native Pi collected from smart contract fees
  totalPiCollected  Float    @default(0)
  
  // The 70/30 Split Calculations (Executed at Month-End)
  pioneerYieldShare Float    @default(0) // 70% of totalPiCollected
  treasuryPolShare  Float    @default(0) // 30% of totalPiCollected
  
  createdAt         DateTime @default(now())
  executedAt        DateTime? 
}

model PioneerVault {
  id               String   @id @default(cuid()) @map("_id")
  pioneerId        String   @unique
  walletAddress    String   @unique
  vaultState       String   @default("Active")
  lockTimestamp    BigInt?
  masterNodes      String[]
  unlockSigs       String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}