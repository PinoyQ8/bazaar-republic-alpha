// 🛡️ NEO PROTOCOL: SCHEMA VERSION 2.1 (Governance Hardened & Mapped)
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"] // 🛡️ BAZAAR TECH: Force platform compatibility
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI") // 🛡️ BAZAAR TECH BYPASS: MONGODB_URI ANCHOR
}

// 🛡️ MESH HIERARCHY: Strict Access Control
enum Tier {
  CITIZEN
  NOVICE
  ACADEMY_CORE
  MESH_GUARDIAN
  BAZAAR_FOUNDER
}

// 🛡️ NODE STATUS: Enforced Consistency
enum NodeStatus {
  SYNCING
  ACTIVE
  FROZEN
  SUSPENDED
}

// 🛡️ PROPOSAL STATE: Hardened Flow
enum ProposalStatus {
  ACTIVE
  PASSED
  REJECTED
  EXPIRED
}

// 🛡️ VOTING STATE: Anti-Injection Lock
enum VoteDecision {
  YES
  NO
  ABSTAIN
}

// 🛡️ MESH LEDGER: PioneerNode Model
model PioneerNode {
  id                  String     @id @default(auto()) @map("_id") @db.ObjectId
  uid                 String     @unique
  username            String?    @unique
  walletAddress       String?    @unique
  
  tier                Tier       @default(CITIZEN) 
  status              NodeStatus @default(SYNCING)
  
  // 🛡️ GOVERNANCE LOCKS
  isFrozen            Boolean    @default(false)
  freezeReason        String?
  
  // 🛡️ IDENTITY & PERFORMANCE
  trustScore          Int        @default(0)
  stakedPi            Float      @default(0)
  signature           String?    
  
  // 🛰️ HARDWARE & TELEMETRY
  ledgerHeight        Int        @default(0)
  syncState           String     @default("Unknown")
  activePeers         Int        @default(0)
  protocol            String     @default("24")
  isUnderRemoteRescue Boolean    @default(false)

  // 🛡️ TIMEKEEPING
  lastActivityTimestamp DateTime   @default(now())
  lastHeartbeat         DateTime   @default(now())
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  // 🛡️ DATABASE ANCHOR: Forces Prisma to read the Mongoose collection
  @@map("pioneerledgers")
}

// 🛰️ ACADEMY LOG MODEL
model AcademyLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  pioneerUid   String   // Logical link to PioneerNode.uid
  moduleLocked String
  createdAt    DateTime @default(now())
}

// 🛡️ PAYMENTS ENGINE
model Payment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  paymentId   String   @unique 
  txid        String   @unique 
  payerUid    String
  merchantUid String
  amount      Float
  status      String   @default("COMPLETED")
  createdAt   DateTime @default(now())
}

// 🛡️ GOVERNANCE: Proposal Matrix
model InternalProposal {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  description     String
  authorUid       String   
  status          ProposalStatus @default(ACTIVE) // 🛡️ UPGRADED to Enum
  targetParameter String?        // For DEX/System tuning
  proposedValue   Float?         // For quantitative proposals
  votesFor        Int            @default(0) 
  votesAgainst    Int            @default(0) 
  expiresAt       DateTime?      // 🛡️ Time-Lock Modifier
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // 🛡️ MESH RELATION: Two-way binding established
  votes           VoteRecord[] 
}

// 🛡️ GOVERNANCE: Vote Ledger
model VoteRecord {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  proposalId  String       @db.ObjectId
  voterId     String
  decision    VoteDecision // 🛡️ UPGRADED to Enum (Prevents arbitrary string injection)
  castAt      DateTime     @default(now())

  // 🛡️ MESH RELATION: Binds the vote directly to the internal proposal cluster
  proposal    InternalProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  // 🛡️ FRONT-RUNNING SHIELD: One vote per Pioneer per proposal
  @@unique([proposalId, voterId]) 
}

// 🛡️ MESH PROTOCOL: Trust Graph Ledger
model SecurityCircle {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  pioneerId      String
  linkedUsername String
  createdAt      DateTime @default(now())

  // 🛡️ FRONT-RUNNING SHIELD: Prevents duplicate anchoring
  @@unique([pioneerId, linkedUsername]) 
}