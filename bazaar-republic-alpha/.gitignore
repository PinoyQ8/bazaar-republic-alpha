# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Ignore local build artifacts
/target/
**/*.rs.bk
Cargo.lock

# Prisma Generated Clients
lib/generated/
prisma/generated/
.env*.local

mesh-scan.js
forge-*.js
monitor-faucet.js
forge-lifeboat-keys.js
forge-evacuation-phase2.js
forge-evacuation-phase3.js

# Sensitive Scripts
scripts/seed-genesis.ts
# Or, if you want to ignore the whole scripts folder for safety:
scripts*

test-db.js