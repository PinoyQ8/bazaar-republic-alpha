  "environment": {
    "NODE_ENV": "production",
    "NEXT_PUBLIC_PI_SANDBOX": "true",
    "NEXT_PUBLIC_BAZAAR_VAULT_CONTRACT_ID": "CATKHAWUKVWCLOVQI654IFYFHPHB6ZSOLZM7OFEFQW52JXP3B6ZIPU5P",
    "NEXT_PUBLIC_MESH_VAULTS_CONTRACT_ID": "CATKHAWUKVWCLOVQI654IFYFHPHB6ZSOLZM7OFEFQW52JXP3B6ZIPU5P",
    "DATABASE_URL": "mongodb://host.docker.internal:27017/bazaar_republic_alpha?directConnection=true",
    "MONGODB_URI": "mongodb://host.docker.internal:27017/bazaar_republic_alpha?directConnection=true"
