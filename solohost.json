**2. Companion `docker-compose.yml` for SoloHost Packaging**

Ensure your bundled `docker-compose.yml` mirrors the registry pull policy and extra hosts mapping[cite: 1]:

```yaml
services:
  web:
    image: docker.io/pinoyq8/bazaar-republic-alpha:latest
    pull_policy: always
    restart: unless-stopped
    ports:
      - "3000:3000"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      - NODE_ENV=production
      - NEXT_PUBLIC_PI_SANDBOX=true
      - DATABASE_URL=mongodb://host.docker.internal:27017/bazaar_republic?directConnection=true
      - MONGODB_URI=mongodb://host.docker.internal:27017/bazaar_republic?directConnection=true
      - NEXT_PUBLIC_BAZAAR_VAULT_CONTRACT_ID=CB5CQFNEPLQRZGNWXIXOXEK4L2LPYUJ3QCCCVHVKE5CSZFJXZ2HZQHIQ
      - NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
      - NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
```[cite: 1, 4]

